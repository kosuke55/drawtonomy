---
interface Props {
	src: string;
	caption?: string;
	maxWidth?: string;
}
const { src, caption, maxWidth = '720px' } = Astro.props;
---

<figure class="dt-demo" style={`max-width:${maxWidth}`}>
	<video
		src={src}
		autoplay
		loop
		muted
		playsinline
		preload="metadata"
		controls
	></video>
	{caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
	.dt-demo {
		margin: 1.5rem 0;
	}
	.dt-demo video {
		width: 100%;
		display: block;
		border-radius: 8px;
		border: 1px solid color-mix(in srgb, var(--sl-color-accent) 25%, transparent);
		background: #000;
	}
	.dt-demo figcaption {
		margin-top: 0.5rem;
		font-size: 0.85rem;
		color: var(--sl-color-gray-3);
		text-align: center;
	}
</style>
